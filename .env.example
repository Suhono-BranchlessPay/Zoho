# BranchlessPay Audit Shield — Zoho Books
BP_LICENSE_KEY=
BP_API_URL=https://branchlesspay.com/api/v1/anchor

# Zoho OAuth 2.0 (https://api-console.zoho.com/)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCESS_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_ORG_NAME=
ZOHO_ORG_ADDRESS=

# Region: US | EU | IN | AU | JP | CA | UK | SA
ZOHO_REGION=US

# Webhook token from Zoho Books Settings → Webhooks
ZOHO_WEBHOOK_TOKEN=

# Local dev
HOST=127.0.0.1
PORT=8080
ZOHO_SKIP_TOKEN_VERIFY=1
